{"$defs":{"CustomMetric":{"additionalProperties":false,"description":"A named oracle function with typed parameters; its HogQL lives in the scenario (§7.3).\n\n- ``power_uploaders``: persons whose earliest ``anchor_event`` in range is followed by at least\n  ``min_count`` ``event`` events within ``within_days`` days (inclusive).\n- ``top_values``: the ``top_n`` values of event ``property`` by count, descending (a ranking).\n- ``distinct_days_users``: persons with ``event`` on more than ``min_days_exclusive`` distinct days.\n- ``first_ever_in_range``: persons whose first-ever ``event`` (whole dataset, SEM-15) is in range.\n- ``detect_cause``: the planted cause behind a symptom on ``event`` within the range.","properties":{"anchor_event":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Anchor Event"},"date_from":{"format":"date","title":"Date From","type":"string"},"date_to":{"format":"date","title":"Date To","type":"string"},"event":{"title":"Event","type":"string"},"filter_test_accounts":{"default":false,"title":"Filter Test Accounts","type":"boolean"},"function":{"enum":["power_uploaders","top_values","distinct_days_users","first_ever_in_range","detect_cause"],"title":"Function","type":"string"},"min_count":{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null,"title":"Min Count"},"min_days_exclusive":{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null,"title":"Min Days Exclusive"},"property":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Property"},"top_n":{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null,"title":"Top N"},"type":{"const":"custom","title":"Type","type":"string"},"within_days":{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null,"title":"Within Days"}},"required":["type","function","event","date_from","date_to"],"title":"CustomMetric","type":"object"},"EASpec":{"additionalProperties":false,"description":"AgentTruth fields of an exact-answer scenario.","properties":{"answer_