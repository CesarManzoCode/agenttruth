ow","order","date_from","date_to","filter_test_accounts"],"title":"FunnelMetric","type":"object"},"FunnelStep":{"additionalProperties":false,"description":"One funnel step: an event name and optional property filters.","properties":{"event":{"title":"Event","type":"string"},"properties":{"items":{"$ref":"#/$defs/PropertyFilter"},"title":"Properties","type":"array"}},"required":["event"],"title":"FunnelStep","type":"object"},"FunnelWindow":{"additionalProperties":false,"description":"Conversion window measured from the step-1 event (SEM-07).","properties":{"n":{"exclusiveMinimum":0,"title":"N","type":"integer"},"unit":{"enum":["second","minute","hour","day","week"],"title":"Unit","type":"string"}},"required":["n","unit"],"title":"FunnelWindow","type":"object"},"JsonValue":{},"PCSpec":{"additionalProperties":false,"description":"AgentTruth fields of a planted-cause scenario.","properties":{"answer_kind":{"const":"cause","title":"Answer Kind","type":"string"},"fault":{"enum":["F1","F2","F3","F4","F5"],"title":"Fault","type":"string"},"kind":{"const":"planted_cause","title":"Kind","type":"string"},"metric":{"$ref":"#/$defs/CustomMetric"},"probes":{"items":{"$ref":"#/$defs/Probe"},"minItems":1,"title":"Probes","type":"array"},"semantics":{"items":{"pattern":"^SEM-(0[1-9]|1[0-5])$","type":"string"},"title":"Semantics","type":"array"},"value_match":{"$ref":"#/$defs/ValueMatch"}},"required":["kind","answer_kind","fault","metric","probes","value_match","semantics"],"title":"PCSpec","type":"object"},"Probe":{"additionalProperties":false,"description":"A numeric probe metric of a planted-cause scenario (triangulated in K2, checked by K1-C4).","properties":{"id":{"title":"Id","type":"string"},"metric":{"discriminator":{"mapping":{"funnel":"#/$defs/FunnelMetric","trends":"#/$defs/TrendsMetric"},"propertyName":"type"},"oneOf":[{"$ref":"#/$defs/TrendsMetric"},{"$ref":"#/$defs/FunnelMetric"}],"title":"Metric"},"posthog_query":{"const":"auto","title":"Posthog Query","type":"string"}},"required":["id","metric","posthog_query"],"title":"Probe","type":"object"},"PropertyFilter":{"additionalProperties":false,"description":"A property filter on an event or on the person (``type: person``) at event time.","properties":{"key":{"title":"Key","type":"string"},"operator":{"enum":["exact","icontains"],"title":"Operator","type":"string"},"type":{"default":"event","enum":["event","person"],"title":"Type","type":"string"},"value":{"title":"Value","type":"string"}},"required":["key","operator","value"],"title":"PropertyFilter","type":"object"},"RASetting":{"additionalProperties":false,"description":"A setting the round-trip agent prompt asks for, with the label the agent reports it under.","properties":{"label":{"title":"Label","type":"string"},"path":{"title":"Path","type":"string"},"value":{"$ref":"#/$defs/JsonValue"}},"required":["label","path","value"],"title":"RASetting","type":"object"},"RASpec":{"additionalProperties":false,"description":"AgentTruth fields of a round-trip-agent scenario (prompts may stay draft until K4).","properties":{"answer_kind":{"const":"roundtrip_report","title":"Answer Kind","type":"string"},"draft":{"title":"Draft","type":"boolean"},"insight":{"enum":["sql","trends","funnels","retention"],"title":"Insight","type":"string"},"keep":{"items":{"$ref":"#/$defs/RASetting"},"title":"Keep","type":"array"},"kind":{"const":"roundtrip_agent","title":"Kind","type":"string"},"operation":{"enum":["create","update"],"title":"Operation","type":"string"},"settings":{"items":{"$ref":"#/$defs/RASetting"},"minItems":1,"title":"Settings","type":"array"}},"required":["kind","answer_kind","draft","insight","operation","settings"],"title":"RASpec","type":"object"},"RSSpec":{"additionalProperties":false,"description":"AgentTruth fields of a round-trip-scripted case: one setting through the MCP save path (§7.4).\n\n``path`` is the dotted path of the setting inside the insight's query object (``source`` for\ninsight-viz queries is implied by ``insight``). Update cases name the settings present before the\nupdate in ``initial`` and how the update is sent in ``operation``.","properties":{"initial":{"anyOf":[{"additionalProperties":{"$ref":"#/$defs/JsonValue"},"type":"object"},{"type":"null"}],"default":null,"title":"Initial"},"insight":{"enum":["sql","trends","funnels","retention"],"title":"Insight","type":"string"},"kind":{"const":"roundtrip_scripted","title":"Kind","type":"string"},"operation":{"enum":["create","update_full_query","update_partial_chart_settings"],"title":"Operation","type":"string"},"path":{"title":"Path","type":"string"},"schema_default":{"$ref":"#/$defs/SchemaFieldRef"},"value":{"$ref":"#/$defs/JsonValue"}},"required":["kind","insight","path","value","schema_default","operation"],"title":"RSSpec","type":"object"},"RetentionMetric":{"additionalProperties":false,"description":"One retention cell (SEM-10, SEM-11): ``{\"cohort_size\", \"retained\"}``.\n\nCohort periods partition the inclusive cohort range ``[date_from, date_to]`` into local buckets of\n``period``; ``cohort_index`` selects one. ``retained`` counts cohort persons with a return event in\nbucket ``cohort + period_index`` or, with ``cumulative``, in any bucket from there up to\n``total_intervals - 1``.","properties":{"cohort_index":{"minimum":0,"title":"Cohort Index","type":"integer"},"cumulative":{"title":"Cumulative","type":"boolean"},"date_from":{"format":"date","title":"Date From","type":"string"},"date_to":{"format":"date","title":"Date To","type":"string"},"filter_test_accounts":{"title":"Filter Test Accounts","type":"boolean"},"period":{"enum":["Day","Week","Month"],"title":"Period","type":"string"},"period_index":{"minimum":1,"title":"Period Index","type":"integer"},"retention_type":{"enum":["retention_first_time","retention_recurring"],"title":"Retention Type","type":"string"},"return_event":{"title":"Return Event","type":"string"},"start_event":{"title":"Start Event","type":"string"},"total_intervals":{"exclusiveMinimum":1,"title":"Total Intervals","type":"integer"},"type":{"const":"retention","title":"Type","type":"string"}},"required":["type","start_event","return_event","period","retention_type","cumulative","total_intervals","date_from","date_to","cohort_index","period_index","filter_test_accounts"],"title":"RetentionMetric","type":"object"},"Scenario":{"additionalProperties":false,"description":"One catalog entry: PostHog ``tasks.yaml`` v2 task fields plus ``agenttruth`` (ADR-0007).","properties":{"acceptable_tools":{"items":{"type":"string"},"title":"Acceptable Tools","type":"array"},"agenttruth":{"discriminator":{"mapping":{"exact_answer":"#/$defs/EASpec","planted_cause":"#/$defs/PCSpec","roundtrip_agent":"#/$defs/RASpec","roundtrip_scripted":"#/$defs/RSSpec"},"propertyName":"kind"},"oneOf":[{"$ref":"#/$defs/EASpec"},{"$ref":"#/$defs/PCSpec"},{"$ref":"#/$defs/RSSpec"},{"$ref":"#/$defs/RASpec"}],"title":"Agenttruth"},"category":{"title":"Category","type":"string"},"expected_tools":{"items":{"type":"string"},"title":"Expected Tools","type":"array"},"id":{"title":"Id","type":"string"},"intent":{"title":"Intent","type":"string"},"success_criteria":{"title":"Success Criteria","type":"string"}},"required":["id","category","intent","expected_tools","acceptable_tools","success_criteria","agenttruth"],"title":"Scenario","type":"object"},"SchemaFieldRef":{"additionalProperties":false,"description":"A field of a class in the vendored ``posthog/schema.py`` (whose default the RS value must differ from).","properties":{"schema_class":{"title":"Schema Class","type":"string"},"schema_field":{"title":"Schema Field","type":"string"}},"required":["schema_class","schema_field"],"title":"SchemaFieldRef","type":"object"},"TrendsMetric":{"additionalProperties":false,"description":"Aggregate of one event over an inclusive local date range (SEM-01, SEM-03, SEM-05, SEM-12).\n\n``math``: ``total`` counts events, ``dau`` counts distinct persons over the whole range, ``sum``\nadds ``math_property`` in integer cents (SEM-14). With ``breakdown`` the value is a mapping keyed\nby the event property value; with ``interval: day`` it is keyed by local date (``YYYY-MM-DD`` or\n``YYYY-MM-DD|<breakdown value>``), zero-filled over every day of the range.","properties":{"breakdown":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Breakdown"},"date_from":{"format":"date","title":"Date From","type":"string"},"date_to":{"format":"date","title":"Date To","type":"string"},"event":{"title":"Event","type":"string"},"filter_test_accounts":{"title":"Filter Test Accounts","type":"boolean"},"interval":{"anyOf":[{"const":"day","type":"string"},{"type":"null"}],"default":null,"title":"Interval"},"math":{"enum":["total","dau","sum"],"title":"Math","type":"string"},"math_property":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Math Property"},"properties":{"items":{"$ref":"#/$defs/PropertyFilter"},"title":"Properties","type":"array"},"type":{"const":"trends","title":"Type","type":"string"}},"required":["type","event","math","date_from","date_to","filter_test_accounts"],"title":"TrendsMetric","type":"object"},"ValueMatch":{"additionalProperties":false,"description":"How a planted-cause answer's ``value`` is compared (§9.2): exact, or contains ``substring``.","properties":{"rule":{"enum":["exact","contains"],"title":"Rule","type":"string"},"substring":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Substring"}},"required":["rule"],"title":"ValueMatch","type":"object"}},"$id":"https://agenttruth.dev/schemas/catalog.v1.json","$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"description":"Scenario catalog file ``scenarios/catalog.v<N>.yaml``.\n\nId uniqueness, kebab-case and category membership are checked by ``scenarios lint`` (K1-C6), not\nhere, so that a malformed catalog still loads and every problem is reported at once.","properties":{"dataset":{"title":"Dataset","type":"string"},"scenarios":{"items